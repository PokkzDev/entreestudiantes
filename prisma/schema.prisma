generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  username            String?   @unique
  name                String?
  email               String    @unique
  emailVerified       DateTime? // NextAuth field for email verification
  password            String
  image               String?
  bio                 String?   @db.Text
  rut                 String?   @unique // RUT del usuario para pagos
  university          String?   // Universidad del usuario
  campus              String?   // Campus de la universidad
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  lastLoginAt         DateTime? // Track last login
  lastActivityAt      DateTime? // Track last activity
  verificationToken   String?  // Token para verificar email
  isVerified          Boolean   @default(false) // Indica si el usuario ya completó el registro
  publicaciones       Publicacion[]
  resetPasswordToken       String?
  resetPasswordTokenExpiry DateTime?
  nameChangeCount     Int      @default(0)
  usernameChangeCount Int      @default(0)
  universityChangeCount Int    @default(0)
  
  // Simplified account tier (for backward compatibility, will be derived from active subscription)
  accountTier         String    @default("free") // "free", "basic", "premium", "elite"
  
  // Moderation fields
  isBanned            Boolean   @default(false)
  isSuspended         Boolean   @default(false)
  isRestricted        Boolean   @default(false)
  isMuted             Boolean   @default(false)
  isWarned            Boolean   @default(false)
  isFlagged           Boolean   @default(false)
  isActive            Boolean   @default(true)
  suspensionEndsAt    DateTime?
  suspensionReason    String?   @db.Text
  banReason           String?   @db.Text
  bannedAt            DateTime?
  suspendedAt         DateTime?
  moderatedBy         String?   // ID of the admin who performed the action
  suspensionCount     Int       @default(0)
  
  // NextAuth required relations (will be auto-created by Prisma adapter but we define for clarity)
  accounts            Account[]
  sessions            Session[]
  reports             Report[]
  paymentLogs         PaymentLog[]
  subscriptions       Subscription[]
  createdRefunds      RefundLog[] @relation("RefundCreator")
  cancelledRefunds    RefundLog[] @relation("RefundCanceller")
}

model Publicacion {
  id            String    @id @default(cuid())
  title         String
  description   String   @db.Text
  type          String   // "producto" or "servicio"
  price         Decimal? @db.Decimal(10, 2)
  images        String   @db.Text // Comma-separated URLs
  category      String
  contactMethod String
  contactInfo   String
  status        String   @default("activo")
  location      String?
  tags          String   // Comma-separated tags
  views         Int      @default(0)
  featured      Boolean  @default(false)
  university    String?  // Universidad del autor al momento de crear la publicación
  campus        String?  // Campus del autor al momento de crear la publicación
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId      String
  
  // Report and moderation fields
  hiddenByReports Boolean  @default(false)
  flagged         Boolean  @default(false)
  reportCount     Int      @default(0)
  hiddenAt        DateTime?
  flaggedAt       DateTime?
  
  // Relations
  reports         Report[]
}

model Subscription {
  id                  String    @id @default(cuid())
  userId              String
  planId              String    // The plan ID (basic, premium, elite)
  status              String    // "active", "cancelled", "expired", "paused"
  startDate           DateTime  // When subscription started
  endDate             DateTime  // When subscription expires
  autoRenew           Boolean   @default(false) // Whether to auto-renew
  cancelledAt         DateTime? // When subscription was cancelled
  cancelReason        String?   // Reason for cancellation
  amount              Int       // Amount paid in CLP (Chilean pesos)
  currency            String    @default("CLP")
  paymentId           String    // Reference to the payment that created this subscription
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  // Relations
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Ensure one subscription per user per payment
  @@unique([userId, paymentId])
  @@index([userId, status])
  @@index([endDate, status])
}

model PaymentLog {
  id                  String    @id @default(cuid())
  userId              String
  planId              String    // The plan that was purchased
  amount              Int       // Amount in CLP (Chilean pesos)
  currency            String    @default("CLP")
  flowToken           String    @unique // Flow.cl token
  commerceOrder       String    // Commerce order ID
  flowOrder           String?   // Flow.cl order number
  status              String    // "pending", "completed", "failed", "cancelled"
  paymentDate         DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  // Relations
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefundLog {
  id                    String    @id @default(cuid())
  refundCommerceOrder   String    @unique // Refund commerce order ID
  flowRefundOrder       String?   // Flow.cl refund order number
  token                 String    @unique // Flow.cl refund token
  receiverEmail         String    // Email of refund receiver
  amount                Int       // Refund amount in CLP (Chilean pesos)
  fee                   Int?      // Flow.cl fee for the refund
  status                String    // "created", "pending", "accepted", "rejected", "cancelled", "completed", "expired"
  originalCommerceOrder String?   // Original payment commerce order
  originalFlowOrder     String?   // Original payment Flow order
  reason                String?   @db.Text // Reason for refund
  createdBy             String    // User ID who created the refund
  cancelledBy           String?   // User ID who cancelled the refund (if applicable)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  cancelledAt           DateTime?
  
  // Relations
  creator               User      @relation("RefundCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  canceller             User?     @relation("RefundCanceller", fields: [cancelledBy], references: [id], onDelete: SetNull)
}

model DeletedAccountLog {
  id            String    @id @default(cuid())
  userId        String    // Original user ID
  username      String?   // Username at time of deletion
  email         String    // Email at time of deletion
  name          String?   // Name at time of deletion
  reason        String?   @db.Text // Optional reason for deletion
  ipAddress     String?   // IP address at time of deletion
  userAgent     String?   @db.Text // Browser/device info
  publicationCount Int    // Number of publications they had
  accountCreatedAt DateTime // When the account was originally created
  accountDeletedAt DateTime @default(now()) // When the account was deleted
}

model DeletedPublicationLog {
  id            String    @id @default(cuid())
  publicationId String    // Original publication ID
  authorId      String    // Original author ID
  username      String?   // Author username at time of deletion
  email         String    // Author email at time of deletion
  title         String    // Publication title
  description   String    @db.Text // Publication description
  type          String    // "producto" or "servicio"
  price         Decimal?  @db.Decimal(10, 2)
  images        String    @db.Text // Comma-separated URLs
  category      String
  contactMethod String
  contactInfo   String
  location      String?
  tags          String    // Comma-separated tags
  university    String?   // Universidad del autor al momento de crear la publicación
  campus        String?   // Campus del autor al momento de crear la publicación
  ipAddress     String?   // IP address that requested deletion
  userAgent     String?   @db.Text // Browser/device info
  reason        String?   @db.Text // Reason for deletion (if provided)
  deletedBy     String    // "user" (self-deletion) or "admin" or "account-deletion"
  publicationCreatedAt DateTime // When the publication was originally created
  deletedAt     DateTime @default(now()) // When the publication was deleted
}

model SubscriptionCancellationLog {
  id                      String    @id @default(cuid())
  userId                  String    // User who cancelled
  username                String?   // Username at time of cancellation
  email                   String    // Email at time of cancellation
  name                    String?   // Name at time of cancellation
  university              String?   // University at time of cancellation
  campus                  String?   // Campus at time of cancellation
  subscriptionId          String?   // ID of the cancelled subscription
  planId                  String    // Plan that was cancelled (basic, premium, elite)
  previousAccountTier     String    // Account tier before cancellation
  reason                  String?   @db.Text // Reason for cancellation
  ipAddress               String?   // IP address at time of cancellation
  userAgent               String?   @db.Text // Browser/device info
  subscriptionStartDate   DateTime? // When the subscription originally started
  subscriptionEndDate     DateTime? // When the subscription was supposed to end
  cancelledAt             DateTime  @default(now()) // When the cancellation occurred
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Report {
  id            String    @id @default(cuid())
  publicacionId String
  reporterId    String?   // Optional - allows anonymous reports
  reason        String
  description   String?   @db.Text
  status        String    @default("pending") // "pending", "approved", "rejected"
  ipAddress     String?
  userAgent     String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  publicacion   Publicacion @relation(fields: [publicacionId], references: [id], onDelete: Cascade)
  reporter      User?       @relation(fields: [reporterId], references: [id], onDelete: SetNull)
}

model AppConfig {
  id          String    @id @default(cuid())
  key         String    @unique
  value       String    @db.Text
  description String?   @db.Text
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AllowedEmailDomain {
  id          String    @id @default(cuid())
  domain      String    @unique
  description String?   @db.Text
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

