generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  username            String?   @unique
  name                String?
  email               String    @unique
  emailVerified       DateTime? // NextAuth field for email verification
  password            String
  image               String?
  bio                 String?   @db.Text
  rut                 String?   @unique // RUT del usuario para pagos
  university          String?   // Universidad del usuario
  campus              String?   // Campus de la universidad
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  lastLoginAt         DateTime? // Track last login
  lastActivityAt      DateTime? // Track last activity
  verificationToken   String?  // Token para verificar email
  isVerified          Boolean   @default(false) // Indica si el usuario ya completó el registro
  publicaciones       Publicacion[]
  resetPasswordToken       String?
  resetPasswordTokenExpiry DateTime?
  nameChangeCount     Int      @default(0)
  usernameChangeCount Int      @default(0)
  universityChangeCount Int    @default(0)
  
  // Subscription/Account Tier fields
  accountTier         String    @default("free") // "free", "basic", "premium", "elite"
  tierStartDate       DateTime?
  tierEndDate         DateTime?
  subscriptionStatus  String    @default("active") // "active", "cancelled", "expired"
  
  // Moderation fields
  isBanned            Boolean   @default(false)
  isSuspended         Boolean   @default(false)
  isRestricted        Boolean   @default(false)
  isMuted             Boolean   @default(false)
  isWarned            Boolean   @default(false)
  isFlagged           Boolean   @default(false)
  isActive            Boolean   @default(true)
  suspensionEndsAt    DateTime?
  suspensionReason    String?   @db.Text
  banReason           String?   @db.Text
  bannedAt            DateTime?
  suspendedAt         DateTime?
  moderatedBy         String?   // ID of the admin who performed the action
  suspensionCount     Int       @default(0)
  
  // NextAuth required relations (will be auto-created by Prisma adapter but we define for clarity)
  accounts            Account[]
  sessions            Session[]
  reports             Report[]
}

model Publicacion {
  id            String    @id @default(cuid())
  title         String
  description   String   @db.Text
  type          String   // "producto" or "servicio"
  price         Decimal? @db.Decimal(10, 2)
  images        String   @db.Text // Comma-separated URLs
  category      String
  contactMethod String
  contactInfo   String
  status        String   @default("activo")
  location      String?
  tags          String   // Comma-separated tags
  views         Int      @default(0)
  featured      Boolean  @default(false)
  university    String?  // Universidad del autor al momento de crear la publicación
  campus        String?  // Campus del autor al momento de crear la publicación
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId      String
  
  // Report and moderation fields
  hiddenByReports Boolean  @default(false)
  flagged         Boolean  @default(false)
  reportCount     Int      @default(0)
  hiddenAt        DateTime?
  flaggedAt       DateTime?
  
  // Relations
  reports         Report[]
}

model DeletedAccountLog {
  id            String    @id @default(cuid())
  userId        String    // Original user ID
  username      String?   // Username at time of deletion
  email         String    // Email at time of deletion
  name          String?   // Name at time of deletion
  reason        String?   @db.Text // Optional reason for deletion
  ipAddress     String?   // IP address at time of deletion
  userAgent     String?   @db.Text // Browser/device info
  publicationCount Int    // Number of publications they had
  accountCreatedAt DateTime // When the account was originally created
  accountDeletedAt DateTime @default(now()) // When the account was deleted
}

model DeletedPublicationLog {
  id            String    @id @default(cuid())
  publicationId String    // Original publication ID
  authorId      String    // Original author ID
  username      String?   // Author username at time of deletion
  email         String    // Author email at time of deletion
  title         String    // Publication title
  description   String    @db.Text // Publication description
  type          String    // "producto" or "servicio"
  price         Decimal?  @db.Decimal(10, 2)
  images        String    @db.Text // Comma-separated URLs
  category      String
  contactMethod String
  contactInfo   String
  location      String?
  tags          String    // Comma-separated tags
  university    String?   // Universidad del autor al momento de crear la publicación
  campus        String?   // Campus del autor al momento de crear la publicación
  ipAddress     String?   // IP address that requested deletion
  userAgent     String?   @db.Text // Browser/device info
  reason        String?   @db.Text // Reason for deletion (if provided)
  deletedBy     String    // "user" (self-deletion) or "admin" or "account-deletion"
  publicationCreatedAt DateTime // When the publication was originally created
  deletedAt     DateTime @default(now()) // When the publication was deleted
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Report {
  id            String    @id @default(cuid())
  publicacionId String
  reporterId    String?   // Optional - allows anonymous reports
  reason        String
  description   String?   @db.Text
  status        String    @default("pending") // "pending", "approved", "rejected"
  ipAddress     String?
  userAgent     String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  publicacion   Publicacion @relation(fields: [publicacionId], references: [id], onDelete: Cascade)
  reporter      User?       @relation(fields: [reporterId], references: [id], onDelete: SetNull)
}

model AppConfig {
  id          String    @id @default(cuid())
  key         String    @unique
  value       String    @db.Text
  description String?   @db.Text
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

