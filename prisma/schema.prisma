generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String         @id @default(cuid())
  username                 String?        @unique
  name                     String?
  email                    String         @unique
  password                 String
  image                    String?
  bio                      String?        @db.Text
  university               String?
  campus                   String?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  verificationToken        String?
  isVerified               Boolean        @default(false)
  resetPasswordToken       String?
  resetPasswordTokenExpiry DateTime?
  nameChangeCount          Int            @default(0)
  usernameChangeCount      Int            @default(0)
  universityChangeCount    Int            @default(0)
  emailVerified            DateTime?
  isActive                 Boolean        @default(true)
  isBanned                 Boolean        @default(false)
  isFlagged                Boolean        @default(false)
  isMuted                  Boolean        @default(false)
  isRestricted             Boolean        @default(false)
  isSuspended              Boolean        @default(false)
  isWarned                 Boolean        @default(false)
  lastActivityAt           DateTime?
  lastLoginAt              DateTime?
  suspensionEndsAt         DateTime?
  suspensionReason         String?        @db.Text
  rut                      String?        @unique
  banReason                String?        @db.Text
  bannedAt                 DateTime?
  moderatedBy              String?
  suspendedAt              DateTime?
  suspensionCount          Int            @default(0)
  accountTier              String         @default("free")
  accounts                 Account[]
  favorites                Favorite[]     @relation("UserFavorites")
  feedbacks                Feedback[]
  paymentLogs              PaymentLog[]
  publicaciones            Publicacion[]
  cancelledRefunds         RefundLog[]    @relation("RefundCanceller")
  createdRefunds           RefundLog[]    @relation("RefundCreator")
  reports                  Report[]
  sessions                 Session[]
  subscriptions            Subscription[]
}

model Publicacion {
  id              String     @id @default(cuid())
  title           String
  description     String     @db.Text
  type            String
  price           Decimal?   @db.Decimal(10, 2)
  images          String     @db.Text
  category        String
  contactMethod   String
  contactInfo     String
  status          String     @default("activo")
  location        String?
  tags            String
  views           Int        @default(0)
  featured        Boolean    @default(false)
  university      String?
  campus          String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  authorId        String
  flagged         Boolean    @default(false)
  flaggedAt       DateTime?
  hiddenAt        DateTime?
  hiddenByReports Boolean    @default(false)
  reportCount     Int        @default(0)
  hiddenByAdmin   Boolean    @default(false)
  favorites       Favorite[] @relation("PublicacionFavorites")
  author          User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reports         Report[]

  @@index([authorId], map: "Publicacion_authorId_fkey")
}

model Subscription {
  id           String    @id @default(cuid())
  userId       String
  planId       String
  status       String
  startDate    DateTime
  endDate      DateTime
  autoRenew    Boolean   @default(false)
  cancelledAt  DateTime?
  cancelReason String?
  amount       Int
  currency     String    @default("CLP")
  paymentId    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, paymentId])
  @@index([userId, status])
  @@index([endDate, status])
}

model PaymentLog {
  id            String   @id @default(cuid())
  userId        String
  planId        String
  amount        Int
  currency      String   @default("CLP")
  flowToken     String   @unique
  commerceOrder String
  flowOrder     String?
  status        String
  paymentDate   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "PaymentLog_userId_fkey")
}

model RefundLog {
  id                    String    @id @default(cuid())
  refundCommerceOrder   String    @unique
  flowRefundOrder       String?
  token                 String    @unique
  receiverEmail         String
  amount                Int
  fee                   Int?
  status                String
  originalCommerceOrder String?
  originalFlowOrder     String?
  reason                String?   @db.Text
  createdBy             String
  cancelledBy           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  cancelledAt           DateTime?
  canceller             User?     @relation("RefundCanceller", fields: [cancelledBy], references: [id])
  creator               User      @relation("RefundCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([cancelledBy], map: "RefundLog_cancelledBy_fkey")
  @@index([createdBy], map: "RefundLog_createdBy_fkey")
}

model DeletedAccountLog {
  id               String   @id @default(cuid())
  userId           String
  username         String?
  email            String
  name             String?
  reason           String?  @db.Text
  ipAddress        String?
  userAgent        String?  @db.Text
  publicationCount Int
  accountCreatedAt DateTime
  accountDeletedAt DateTime @default(now())
}

model DeletedPublicationLog {
  id                   String   @id @default(cuid())
  publicationId        String
  authorId             String
  username             String?
  email                String
  title                String
  description          String   @db.Text
  type                 String
  price                Decimal? @db.Decimal(10, 2)
  images               String   @db.Text
  category             String
  contactMethod        String
  contactInfo          String
  location             String?
  tags                 String
  university           String?
  campus               String?
  ipAddress            String?
  userAgent            String?  @db.Text
  reason               String?  @db.Text
  deletedBy            String
  publicationCreatedAt DateTime
  deletedAt            DateTime @default(now())
}

model SubscriptionCancellationLog {
  id                    String    @id @default(cuid())
  userId                String
  username              String?
  email                 String
  name                  String?
  university            String?
  campus                String?
  subscriptionId        String?
  planId                String
  previousAccountTier   String
  reason                String?   @db.Text
  ipAddress             String?
  userAgent             String?   @db.Text
  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?
  cancelledAt           DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "Account_userId_fkey")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Session_userId_fkey")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Report {
  id            String      @id @default(cuid())
  publicacionId String
  reporterId    String?
  reason        String
  description   String?     @db.Text
  status        String      @default("pending")
  ipAddress     String?
  userAgent     String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  publicacion   Publicacion @relation(fields: [publicacionId], references: [id], onDelete: Cascade)
  reporter      User?       @relation(fields: [reporterId], references: [id])

  @@index([publicacionId], map: "Report_publicacionId_fkey")
  @@index([reporterId], map: "Report_reporterId_fkey")
}

model AppConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AllowedEmailDomain {
  id          String   @id @default(cuid())
  domain      String   @unique
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AccountTier {
  id               String   @id @default(cuid())
  tierKey          String   @unique
  name             String
  publicationLimit Int?
  price            Int
  features         String   @db.Text
  icon             String
  color            String
  bgColor          String
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model Feedback {
  id        String   @id @default(cuid())
  type      String
  subject   String
  message   String   @db.Text
  email     String?
  userId    String?
  status    String   @default("open")
  priority  String   @default("medium")
  ipAddress String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])

  @@index([type, status])
  @@index([userId])
  @@index([createdAt])
}

model Favorite {
  id            String      @id @default(cuid())
  userId        String
  publicacionId String
  createdAt     DateTime    @default(now())
  publicacion   Publicacion @relation("PublicacionFavorites", fields: [publicacionId], references: [id], onDelete: Cascade)
  user          User        @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, publicacionId])
  @@index([userId])
  @@index([publicacionId])
}

model Admin {
  id                   String    @id @default(cuid())
  username             String    @unique
  email                String    @unique
  password             String
  name                 String?
  role                 String    @default("admin")
  permissions          String    @db.Text
  isActive             Boolean   @default(true)
  lastLoginAt          DateTime?
  lastActivityAt       DateTime?
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?
  loginAttempts        Int       @default(0)
  lockedUntil          DateTime?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([email])
  @@index([username])
  @@index([isActive])
  @@index([role])
}
